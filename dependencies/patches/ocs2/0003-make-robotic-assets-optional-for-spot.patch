From: Spot OCS2 Humble compatibility layer
Subject: [PATCH] Drop example robot assets from the Spot production build

The Spot integration supplies its own URDF and configuration and never loads
the ANYmal or mobile-manipulator resources in ocs2_robotic_assets. Remove that
hard production dependency from the three packages in the Spot build closure.

The omitted tests and launch files are upstream ANYmal-specific examples
whose factory helpers or default URDF paths load ocs2_robotic_assets at
runtime. Spot's own model, QP, standing, and locomotion tests and launch file
remain enabled in their owning packages.

diff --git a/ocs2_pinocchio/ocs2_centroidal_model/CMakeLists.txt b/ocs2_pinocchio/ocs2_centroidal_model/CMakeLists.txt
--- a/ocs2_pinocchio/ocs2_centroidal_model/CMakeLists.txt
+++ b/ocs2_pinocchio/ocs2_centroidal_model/CMakeLists.txt
@@ -7,7 +7,6 @@ set(CMAKE_POSITION_INDEPENDENT_CODE ON)
 find_package(ament_cmake REQUIRED)
 find_package(ocs2_core REQUIRED)
 find_package(ocs2_robotic_tools REQUIRED)
-find_package(ocs2_robotic_assets REQUIRED)
 find_package(ocs2_pinocchio_interface REQUIRED)
 find_package(pinocchio REQUIRED)
 find_package(Eigen3 3.3 REQUIRED NO_MODULE)
@@ -35,7 +34,6 @@ target_include_directories(${PROJECT_NAME}
 ament_target_dependencies(${PROJECT_NAME}
   ocs2_core
   ocs2_robotic_tools
-  ocs2_robotic_assets
   ocs2_pinocchio_interface
 )
 target_compile_options(${PROJECT_NAME} PUBLIC ${OCS2_PINOCCHIO_FLAGS})
@@ -66,7 +64,6 @@ ament_export_targets(export_${PROJECT_NAME} HAS_LIBRARY_TARGET)
 ament_export_dependencies(
   ocs2_core
   ocs2_robotic_tools
-  ocs2_robotic_assets
   ocs2_pinocchio_interface
   Eigen3
   Boost
@@ -74,25 +71,4 @@ ament_export_dependencies(
   pinocchio
 )
 
