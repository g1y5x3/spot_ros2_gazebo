<?xml version="1.0"?>
<package format="3">
  <name>spot_state_estimator</name>
  <version>0.1.0</version>
  <description>Replaceable simulation state adapter for Spot OCS2.</description>
  <maintainer email="maintainers@example.com">OCS2 Spot maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>python3-setuptools</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>pinocchio</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>spot_description</exec_depend>
  <exec_depend>spot_effort_controller</exec_depend>
  <exec_depend>spot_state_interface</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
